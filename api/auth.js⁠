export default async function handler(req, res) {
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  const { action, email, password } = req.body || {};

  if (!email || !password) {
    return res.status(400).json({ error: 'Email and password are required.' });
  }

  // Active Supabase credentials matching test-maker.html
  const SUPABASE_URL = "https://cbgwbzidkmcefoithipp.supabase.co";
  const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNiZ3diemlka21jZWZvaXRoaXBwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYyMDgyNTQsImV4cCI6MjEwMTc4NDI1NH0.gJq3-0tU-8fxdF0Y_1_qcet_VYp7gysv5yWfl_o8T0g";

  const endpoint = action === 'signup' 
    ? `${SUPABASE_URL}/auth/v1/signup` 
    : `${SUPABASE_URL}/auth/v1/token?grant_type=password`;

  try {
    const response = await fetch(endpoint, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'apikey': SUPABASE_ANON_KEY,
        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`
      },
      body: JSON.stringify({
        email: email.trim().toLowerCase(),
        password: password.trim()
      })
    });

    const data = await response.json();

    if (!response.ok) {
      const errMsg = data.msg || data.error_description || data.message || 'Authentication failed';
      return res.status(400).json({ error: errMsg });
    }

    return res.status(200).json({ success: true, session: data });
  } catch (err) {
    return res.status(500).json({ error: err.message || 'Internal server error' });
  }
}
